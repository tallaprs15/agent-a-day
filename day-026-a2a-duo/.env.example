# Copy to .env (git-ignored) and fill in. Never commit real keys.
GOOGLE_API_KEY=your-gemini-api-key
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Optional
GEMINI_MODEL=gemini-3.5-flash-lite
MAX_TOOL_CALLS=8
# Where `adk web` finds a librarian started with `python -m a2a_duo serve`
# LIBRARIAN_URL=http://127.0.0.1:8001/.well-known/agent-card.json
# USD per 1M tokens, for the cost meter (check current Gemini pricing)
# GEMINI_PRICE_IN=
# GEMINI_PRICE_OUT=
