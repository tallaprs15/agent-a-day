# Copy to .env (git-ignored) and fill in. Never commit real keys.
GOOGLE_API_KEY=your-gemini-api-key
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Optional
GEMINI_MODEL=gemini-3.5-flash-lite
MAX_TOOL_CALLS=14
MAX_PAGES=5
# Use an already-installed Chrome/Chromium instead of letting Playwright find one
# PLAYWRIGHT_MCP_EXECUTABLE_PATH=/usr/bin/chromium
# USD per 1M tokens, for the cost meter (check current Gemini pricing)
# GEMINI_PRICE_IN=
# GEMINI_PRICE_OUT=
