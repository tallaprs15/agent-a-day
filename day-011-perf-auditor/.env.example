# Copy to .env (git-ignored) and fill in. Never commit real keys.
GOOGLE_API_KEY=your-gemini-api-key
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Optional
GEMINI_MODEL=gemini-3.5-flash-lite
MAX_TOOL_CALLS=10
# Chrome binary for DevTools MCP (default: the Chrome stable it finds)
# CHROME_PATH=/usr/bin/chromium
# Set to 1 when Chrome must run without its sandbox (containers, CI)
# CHROME_NO_SANDBOX=1
# USD per 1M tokens, for the cost meter (check current Gemini pricing)
# GEMINI_PRICE_IN=
# GEMINI_PRICE_OUT=
