# Copy to .env (git-ignored) and fill in. Never commit real keys.
GOOGLE_API_KEY=your-gemini-api-key
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Optional
GEMINI_MODEL=gemini-3.5-flash-lite
MAX_TOOL_CALLS=6
# Optional: use the official GitHub MCP server (read-only) instead of mcp-server-fetch.
# Create a fine-grained token with read-only repository permissions; never reuse a token that can write.
# GITHUB_MCP_TOKEN=
# USD per 1M tokens, for the cost meter (check current Gemini pricing)
# GEMINI_PRICE_IN=
# GEMINI_PRICE_OUT=
