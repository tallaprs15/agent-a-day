# Copy to .env (git-ignored) and fill in. Never commit real keys.
GOOGLE_API_KEY=your-gemini-api-key
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Optional
GEMINI_MODEL=gemini-3.5-flash-lite       # router and cheap worker
GEMINI_STRONG_MODEL=gemini-3.8-flash     # worker for hard requests
ROUTE_THRESHOLD=5                        # difficulty total (0-9) at or above which the strong model is used
MAX_TOOL_CALLS=6
# USD per 1M tokens for the cost meter (check current Gemini pricing); unset means tokens only
# GEMINI_PRICE_LITE_IN=
# GEMINI_PRICE_LITE_OUT=
# GEMINI_PRICE_STRONG_IN=
# GEMINI_PRICE_STRONG_OUT=
